# Place as ~/.distroboxrc on the host system.
# This is sourced as you enter the distrobox. Additionally first-run.sh calls
# this as a script from inside the container (invoking it on the host system).

xhost +si:localuser:"$USER" &>/dev/null || true

for subdir in 100dpi 75dpi; do
    dir="$HOME/.local/share/x11-fonts/$subdir"
    [[ -d "$dir" ]] || continue
    xset +fp "$dir" 2>/dev/null || true
done

xset fp rehash 2>/dev/null || true

unset subdir dir
